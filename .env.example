# Copy to .env and adjust. POSTGRES_PASSWORD is required.

# --- Required ---
POSTGRES_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# --- Published ports ---
GATEWAY_PORT=18080       # unified REST interface
MCP_PORT=18081           # MCP (Streamable HTTP)
PLAYWRIGHT_HOST_PORT=13000  # playwright-service, for non-docker consumers
PLAYWRIGHT_BIND=127.0.0.1   # localhost-only; 0.0.0.0 exposes an unauthenticated browser driver on the LAN

# --- Auth ---
# Bearer key required on the REST gateway AND the MCP endpoint. Generate one:
#   openssl rand -hex 32
# With neither this nor ALLOW_UNAUTHENTICATED the services refuse to start.
GATEWAY_API_KEY=
# Explicit opt-out: run both interfaces with no auth (trusted-local use only).
ALLOW_UNAUTHENTICATED=

# --- External LLM + search (must be reachable via docker DNS or an IP/URL) ---
# Defaults assume `ollama` and `searxng` containers on the `llm-network`
# docker network (see docker-compose.yaml comments for bootstrap commands).
OLLAMA_BASE_URL=http://ollama:11434
# OpenAI-compatible endpoint used by the upstream api — keep in step with
# OLLAMA_BASE_URL (<base>/v1)
OPENAI_BASE_URL=http://ollama:11434/v1
SEARXNG_ENDPOINT=http://searxng:8080
# llama3.1:8b works; a thinking model (qwen3:14b recommended — see README
# "Model choice") substantially improves /v1/interact prompt-mode planning.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Keep the model resident between calls ("-1" = never unload; first call after
# idle pays the cold-load, which can exceed a minute for 27b+ models on CPU)
OLLAMA_KEEP_ALIVE=30m
# Per-call Ollama timeout (ms) used by gateway + interact
OLLAMA_TIMEOUT_MS=180000

# --- Firecrawl tuning ---
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
LOGGING_LEVEL=INFO
BLOCK_MEDIA=
HARNESS_STARTUP_TIMEOUT_MS=120000

# --- Playwright service (upstream JS-rendering microservice) ---
# Shared beyond the api: reachable on `llm-network` as playwright-service:3000
# and on the host at PLAYWRIGHT_HOST_PORT for non-docker consumers.
MAX_CONCURRENT_PAGES=10
# Optional outbound proxy for rendered pages / local webhook allowance
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
ALLOW_LOCAL_WEBHOOKS=

# --- Interact service ---
INTERACT_SESSION_TTL_MS=600000
INTERACT_MAX_SESSIONS=10
INTERACT_JOB_TTL_MS=600000
# Vision model describing page screenshots during prompt-mode agent steps
# (needs a VLM in ollama, e.g. qwen2.5vl; empty disables; "vision" request
# field overrides per call)
INTERACT_VISION_MODEL=
# Set to 1 to abort tracker/ad network requests in every interact session
INTERACT_ADBLOCK=
# Comma-separated browser launch args retried once when a page fails to load
# (helps with CDNs that reject headless HTTP/2, e.g. Akamai)
INTERACT_FALLBACK_LAUNCH_ARGS=--disable-http2,--disable-blink-features=AutomationControlled
# SSRF guard (default on): interact refuses URLs resolving to private/internal
# addresses — docker service names, host.docker.internal, link-local/cloud
# metadata. Set to 1 only if you need to browse internal targets.
INTERACT_ALLOW_PRIVATE=

# --- SearXNG (optional search tuning) ---
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
